{
  "name": "@fairu/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Fairu GraphQL API with React hooks and vanilla client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./fragments": {
      "import": {
        "types": "./dist/fragments.d.ts",
        "default": "./dist/fragments.js"
      },
      "require": {
        "types": "./dist/fragments.d.cts",
        "default": "./dist/fragments.cjs"
      }
    },
    "./upload": {
      "import": {
        "types": "./dist/upload.d.ts",
        "default": "./dist/upload.js"
      },
      "require": {
        "types": "./dist/upload.d.cts",
        "default": "./dist/upload.cjs"
      }
    },
    "./fileproxy": {
      "import": {
        "types": "./dist/fileproxy.d.ts",
        "default": "./dist/fileproxy.js"
      },
      "require": {
        "types": "./dist/fileproxy.d.cts",
        "default": "./dist/fileproxy.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@urql/core": ">=5.0.0",
    "@urql/exchange-graphcache": ">=7.0.0",
    "graphql": ">=16.0.0",
    "react": ">=18.0.0",
    "urql": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "urql": {
      "optional": true
    },
    "@urql/exchange-graphcache": {
      "optional": true
    }
  },
  "dependencies": {
    "wonka": "^6.3.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typed-document-node": "^6.1.5",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.3.2",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@urql/core": "^5.1.0",
    "@urql/exchange-auth": "^3.0.0",
    "@urql/exchange-graphcache": "^7.2.0",
    "@urql/exchange-retry": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "graphql": "^16.10.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "urql": "^4.2.0",
    "vite": "^6.0.6",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushidev-team/fairu-sdk-typescript.git"
  },
  "keywords": [
    "fairu",
    "graphql",
    "react",
    "urql",
    "hooks",
    "sdk",
    "digital-asset-management",
    "dam",
    "typescript"
  ],
  "author": "Fairu <hello@fairu.app>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sushidev-team/fairu-sdk-typescript/issues"
  },
  "homepage": "https://github.com/sushidev-team/fairu-sdk-typescript#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
